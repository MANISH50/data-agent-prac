{
  "permissions": {
    "allow": [
      "Bash(python de-lab/*)",
      "Bash(python3 de-lab/*)",
      "Bash(duckdb -readonly *)",
      "Bash(dbt build *)",
      "Bash(dbt test *)",
      "Bash(dbt parse *)",
      "Bash(git status)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_warehouse.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/dbt_parse_after_edit.sh\"" }
        ]
      }
    ]
  }
}
